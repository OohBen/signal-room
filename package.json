{
  "name": "signal-room",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "smoke:live": "node scripts/smoke-live-demo.mjs",
    "smoke:audio-ws": "node scripts/smoke-live-audio-ws.mjs",
    "status": "node scripts/check-project.mjs",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:gateway": "pnpm --dir apps/gateway dev",
    "spacetime:build": "spacetime build --module-path apps/spacetime/spacetimedb",
    "spacetime:publish": "spacetime publish signal-room --module-path apps/spacetime/spacetimedb --yes",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir apps/web/src/module_bindings --module-path apps/spacetime/spacetimedb"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
