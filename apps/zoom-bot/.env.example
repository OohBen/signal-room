# Copy this file to .env and fill in real values.
# .env is gitignored. config.toml is generated from it by bin/gen-config.sh.

# Zoom Meeting SDK credentials — from Marketplace app -> App Credentials.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Join URL of the meeting the bot should join.
# Format: https://us02web.zoom.us/j/<meeting-id>?pwd=<encoded-password>
# The bot parses meeting-id + password from this URL automatically.
ZOOM_JOIN_URL=

# Cloud-forward bridge config — read by client/src/index.js.
OPENAI_API_KEY=
SPACETIME_TOKEN=
BRIDGE_GATEWAY_URL=https://sig-api.benautomates.com
BRIDGE_ROOM_CODE=ZOOM-LIVE
BRIDGE_DISPLAY_NAME="Signal Room Notetaker"
BRIDGE_SPACETIME_DB=signal-room
BRIDGE_REALTIME_MODEL=gpt-realtime-2
BRIDGE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15

# Local dev only: if you run the gateway on your laptop from inside Docker,
# override BRIDGE_GATEWAY_URL=http://host.docker.internal:8787.
