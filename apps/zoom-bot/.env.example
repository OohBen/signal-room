# Copy this file to .env and fill in real values.
# .env is gitignored. config.toml is generated from it by bin/gen-config.sh.

# Zoom Meeting SDK credentials — from Marketplace app -> App Credentials.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Join URL of the meeting the bot should join.
# Format: https://us02web.zoom.us/j/<meeting-id>?pwd=<encoded-password>
# The bot parses meeting-id + password from this URL automatically.
ZOOM_JOIN_URL=

# Bridge config — read by client/src/index.js.
BRIDGE_GATEWAY_URL=ws://host.docker.internal:8787/live-audio
BRIDGE_ROOM_CODE=ZOOM-DEFAULT
BRIDGE_DISPLAY_NAME="Signal Room Notetaker"
BRIDGE_SPACETIME_DB=signal-room
