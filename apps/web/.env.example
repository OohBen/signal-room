# Copy this file to apps/web/.env (gitignored) and fill in real values.
#
# These VITE_* vars MUST live in apps/web/.env (not the repo-root .env). Vite
# 8 has a known bug where the `envDir: "../.."` setting in vite.config.ts is
# silently dropped, so the root .env is never read for production or dev builds.
# The vite.config.ts has been updated to resolve envDir from import.meta.url,
# but the safest fix is to keep VITE_* here.

VITE_GATEWAY_URL=http://127.0.0.1:8787
VITE_SPACETIME_URI=wss://maincloud.spacetimedb.com
VITE_SPACETIME_DATABASE=signal-room-server-v3dax
