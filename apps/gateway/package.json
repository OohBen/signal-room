{
  "name": "signal-room-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "signal-room-gateway": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && node --enable-source-maps dist/index.js serve",
    "health": "pnpm build && node --enable-source-maps dist/index.js health",
    "smoke": "pnpm build && node --enable-source-maps dist/index.js smoke",
    "work-once": "pnpm build && node --enable-source-maps dist/index.js work-once"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "exa-js": "^2.13.0",
    "openai": "^6.42.0"
  }
}
